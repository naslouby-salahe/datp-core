[importlinter]
root_packages =
    datp_core
include_external_packages = False

[importlinter:contract:centralized-isolation]
name = Centralized reference must not import federated scoring, thresholding, or federated learning
type = forbidden
source_modules =
    datp_core.centralized_reference
forbidden_modules =
    datp_core.scoring
    datp_core.thresholding
    datp_core.learning.federated

[importlinter:contract:federated-scoring-isolation]
name = Federated scoring must not import centralized reference
type = forbidden
source_modules =
    datp_core.scoring
forbidden_modules =
    datp_core.centralized_reference

[importlinter:contract:thresholding-isolation]
name = Federated thresholding must not import centralized reference
type = forbidden
source_modules =
    datp_core.thresholding
forbidden_modules =
    datp_core.centralized_reference

[importlinter:contract:pipeline-neutrality]
name = Shared pipeline infrastructure must not import branch or application packages
type = forbidden
source_modules =
    datp_core.pipeline
forbidden_modules =
    datp_core.centralized_reference
    datp_core.scoring
    datp_core.thresholding
    datp_core.calibration
    datp_core.evaluation
    datp_core.analysis
    datp_core.reporting
    datp_core.orchestration
    datp_core.cli

[importlinter:contract:learning-isolation]
name = Learning implementations must not import application composition layers
type = forbidden
source_modules =
    datp_core.learning
forbidden_modules =
    datp_core.orchestration
    datp_core.reporting
    datp_core.cli

[importlinter:contract:dataset-direction]
name = Dataset implementations must not depend on populations or application composition
type = forbidden
source_modules =
    datp_core.datasets
forbidden_modules =
    datp_core.populations
    datp_core.orchestration
    datp_core.reporting
    datp_core.cli

[importlinter:contract:population-direction]
name = Population implementations must not depend on application composition
type = forbidden
source_modules =
    datp_core.populations
forbidden_modules =
    datp_core.orchestration
    datp_core.reporting
    datp_core.cli

[importlinter:contract:preprocessing-direction]
name = Preprocessing implementations must not depend on application composition
type = forbidden
source_modules =
    datp_core.preprocessing
forbidden_modules =
    datp_core.orchestration
    datp_core.reporting
    datp_core.cli

[importlinter:contract:artifact-direction]
name = Artifact infrastructure must not depend on application composition
type = forbidden
source_modules =
    datp_core.artifacts
forbidden_modules =
    datp_core.orchestration
    datp_core.reporting
    datp_core.analysis
    datp_core.cli

[importlinter:contract:protocol-direction]
name = Protocol declarations must not depend on orchestration, reporting, or CLI
type = forbidden
source_modules =
    datp_core.protocols
forbidden_modules =
    datp_core.orchestration
    datp_core.reporting
    datp_core.cli

[importlinter:contract:domain-independence]
name = Domain package must not import application layers
type = forbidden
source_modules =
    datp_core.domain
forbidden_modules =
    datp_core.cli
    datp_core.orchestration
    datp_core.reporting
    datp_core.analysis
    datp_core.experiments
    datp_core.evaluation
    datp_core.thresholding
    datp_core.calibration
    datp_core.anchor
    datp_core.scoring
    datp_core.centralized_reference
    datp_core.learning
    datp_core.preprocessing
    datp_core.populations
    datp_core.datasets
    datp_core.artifacts
    datp_core.pipeline
    datp_core.runtime
    datp_core.protocols

[importlinter:contract:cli-not-imported]
name = No package may import the CLI module
type = forbidden
source_modules =
    datp_core.domain
    datp_core.protocols
    datp_core.datasets
    datp_core.populations
    datp_core.preprocessing
    datp_core.learning
    datp_core.pipeline
    datp_core.scoring
    datp_core.centralized_reference
    datp_core.thresholding
    datp_core.calibration
    datp_core.evaluation
    datp_core.analysis
    datp_core.reporting
    datp_core.artifacts
    datp_core.runtime
    datp_core.anchor
    datp_core.experiments
    datp_core.orchestration
forbidden_modules =
    datp_core.cli
