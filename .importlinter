[importlinter]
root_packages =
    datp_core
include_external_packages = False

[importlinter:contract:core-foundation]
name = Core must not depend on any upper layer
type = forbidden
source_modules =
    datp_core.core
forbidden_modules =
    datp_core.protocols
    datp_core.data
    datp_core.detector
    datp_core.thresholds
    datp_core.analysis
    datp_core.experiments
    datp_core.artifacts
    datp_core.presentation
    datp_core.app
    datp_core.runtime

[importlinter:contract:runtime-foundation]
name = Runtime must not depend on scientific or application layers
type = forbidden
source_modules =
    datp_core.runtime
forbidden_modules =
    datp_core.protocols
    datp_core.data
    datp_core.detector
    datp_core.thresholds
    datp_core.analysis
    datp_core.experiments
    datp_core.artifacts
    datp_core.presentation
    datp_core.app

[importlinter:contract:protocols-no-adapters]
name = Scientific protocols must not depend on application or presentation adapters
type = forbidden
source_modules =
    datp_core.protocols
forbidden_modules =
    datp_core.presentation
    datp_core.app

[importlinter:contract:scientific-no-app]
name = Scientific packages must not depend on application adapters
type = forbidden
source_modules =
    datp_core.data
    datp_core.detector
    datp_core.thresholds
    datp_core.analysis
forbidden_modules =
    datp_core.presentation
    datp_core.app

[importlinter:contract:presentation-no-app]
name = Presentation must not depend on application or command-line adapters
type = forbidden
source_modules =
    datp_core.presentation
forbidden_modules =
    datp_core.app

[importlinter:contract:experiments-no-cli]
name = Experiment recipes must not depend on command-line adapters
type = forbidden
source_modules =
    datp_core.experiments
forbidden_modules =
    datp_core.app.cli
